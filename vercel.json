{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "schedules": {
    "cfo": {
      "schedule": "30 5 * * *",
      "timezone": "America/Chicago",
      "path": "/api/agents/cfo",
