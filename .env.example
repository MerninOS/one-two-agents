# Copy to .env.local for local runs. In production these live in your host's settings (on Vercel,
# the project's Environment Variables).

# Vercel Cron sends this as a bearer token; manual runs and /api/health use it too.
# Any long random string: openssl rand -base64 32
CRON_SECRET=

# Your Supabase project (docs/self-host.md). Service role, server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# The database lock (docs/tenancy.md, slice 2b). Both blank = off. Our ES256 private key (JWK JSON,
# imported into Supabase as its signing key) and the project's publishable key.
SUPABASE_SIGNING_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Claude API key
ANTHROPIC_API_KEY=

# Shopify Admin API through the read-only custom app you make in Shopify (for example "Agents (read)")
# (scopes: read_products, read_inventory, read_orders, read_locations, read_customers).
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2026-07
# The app's key (Admin API access token, or a Dev Dashboard app's client secret) is pasted on
# Connections into the token vault; a key whose app has any write scope is refused.
# A Dev Dashboard app's client id (not a secret), when its client secret is the pasted key:
SHOPIFY_CLIENT_ID=

# Mercury reads are signed in on Connections (Mercury's MCP server, read scope only), not set here.
# So are the gateway's two write sign-ins: Mercury writes (category and memo) and Mercury receipt files.
# Accounts that count as cash: "all" (every non-credit account the token sees) or comma-separated IDs.
MERCURY_ACCOUNT_IDS=all

# Notion: the integration's key is pasted on Connections (token vault), not set here. The page the
# morning briefs and lead lists go under, shared with that integration:
NOTION_BRIEF_PARENT_ID=
# Optional: each agent's own page for its run pages (Rowan's "Lead runs", Quinn's "Books runs").
# The id is the 32 characters at the end of the page's URL. The page, or a page above it, must be
# shared with the integration. Blank = run pages go under NOTION_BRIEF_PARENT_ID.
NOTION_LEADS_PARENT_ID=
NOTION_BOOKS_PARENT_ID=
# The "Briefs" database: Avery writes one row per morning brief.
# The id is the 32 characters in the database's URL. Blank = one page per brief under the parent.
NOTION_BRIEFS_DB_ID=
# The Build Board database: a yes on a new-tool proposal adds a card in Up next,
# and Mark built moves it to Done. The database must be shared with the integration. Blank = no card.
NOTION_BUILD_BOARD_DB_ID=

# Email to the owner only (the morning brief and alerts), sent through Resend. BRIEF_FROM must be a
# sender on a domain verified in Resend; BRIEF_TO is the one fixed recipient. Blank = the
# brief goes to Notion only.
RESEND_API_KEY=
BRIEF_FROM=Avery <avery@updates.example.com>
BRIEF_TO=
# Control Room address for links in the brief (default: the Vercel production URL)
DASHBOARD_URL=

# The app's Google OAuth client (Web application) for the two Gmail sign-ins made with Connect on
# Connections: "Gmail (read only)" (gmail.readonly, Quinn's receipts) and "Gmail drafts" (gmail.compose,
# gateway only). Add https://<your domain>/connections/gmail_read/callback and
# /connections/gmail/callback as Authorized redirect URIs. No refresh tokens here: they are in the vault.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Storefront URL named in outreach drafts
SITE_URL=

# Control Room (the dashboard at /). People sign in with an emailed link (docs/tenancy.md, slice 2).
# Signs session cookies; at least 32 characters (openssl rand -base64 32). Unset = nobody can sign in.
SESSION_SECRET=
# Becomes the first owner on first sign-in while the org has no members.
OPERATOR_OWNER_EMAIL=
# Real runs, putting an agent back on the crew and raising budgets from the dashboard.
# Off unless "on". Dry runs and taking agents off duty always work.
DASHBOARD_CONTROLS=

# Self-hosting with docker compose only (docs/self-host.md); Vercel ignores these.
# The Supabase database's connection string, for the one-off migration step.
DATABASE_URL=
# This app's own address as people reach it, for sign-in links (default http://localhost:3000).
APP_URL=
