# Copy to .env.local for local runs. In production these live in the Vercel project
# one-two-agents only (never in the storefront's project).

# Vercel Cron sends this as a bearer token; manual runs and /api/health use it too.
# Any long random string: openssl rand -base64 32
CRON_SECRET=

# Supabase project one-two-agents (lptfkikpiumiodpjaxal): agents, agent_runs,
# kpi_snapshots, policies, wholesale_leads. Service role, server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API key (key named one-two-agents)
ANTHROPIC_API_KEY=

# Shopify Admin API through the read-only app "One Two Agents (read)"
# (scopes: read_products, read_inventory, read_orders, read_locations, read_customers).
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2026-07
# Either the Dev Dashboard app's credentials (client-credentials grant)…
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# …or a static Admin API token.
SHOPIFY_ADMIN_ACCESS_TOKEN=
# Collection holding "Our coffees" (default our-coffees)
SHOPIFY_STOCK_COLLECTION=

# Mercury read-only API token from One Two's business org. Blank = cash shows n/a and the
# Bookkeeper can't run. The Bookkeeper reads every account the token sees.
MERCURY_API_TOKEN=
# Gateway-only Mercury token (Custom token, transaction write scope only) used to apply the
# receipt, category and memo changes Zak approves. Blank = approvals are recorded, nothing is written.
MERCURY_WRITE_TOKEN=
# Accounts that count as cash: "all" (every non-credit account the token sees) or comma-separated IDs.
MERCURY_ACCOUNT_IDS=all

# Notion internal integration, shared with the page the morning briefs and lead lists go under
NOTION_TOKEN=
NOTION_BRIEF_PARENT_ID=
# The "Briefs" database: Avery writes one row per morning brief (docs/avery-briefs-database.md).
# The id is the 32 characters in the database's URL. Blank = one page per brief under the parent.
NOTION_BRIEFS_DB_ID=

# Email to Zak only (Avery's morning brief), sent through Resend. BRIEF_FROM must be a
# sender on a domain verified in Resend; BRIEF_TO is the one fixed recipient. Blank = the
# brief goes to Notion only.
RESEND_API_KEY=
BRIEF_FROM=Avery <avery@updates.onetwocoffeelab.com>
BRIEF_TO=
# Control Room address for links in the brief (default: the Vercel production URL)
DASHBOARD_URL=

# Gmail for Wholesale Hunter drafts: OAuth client and a refresh token for zak@onetwocoffeelab.com
# with only the gmail.compose scope. Blank = drafts appear in Notion only.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Bookkeeper receipt search: a second refresh token for the same mailbox and OAuth client,
# granted only https://www.googleapis.com/auth/gmail.readonly. Blank = no receipt search.
GMAIL_RECEIPTS_REFRESH_TOKEN=

# Storefront URL named in outreach drafts (default https://onetwocoffeelab.com)
SITE_URL=

# Control Room (the dashboard at /). One password; unset = nobody can sign in.
DASHBOARD_PASSWORD=
# Real runs, putting an agent back on the crew and raising budgets from the dashboard.
# Off unless "on". Dry runs and taking agents off duty always work.
DASHBOARD_CONTROLS=
