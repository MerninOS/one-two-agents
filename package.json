    "check:business": "npx --yes tsx scripts/check-business.ts",
    "check:settings": "npx --yes tsx scripts/check-settings.ts",
    "check:books": "npx --yes tsx scripts/check-books.ts",
    "check:product-facts": "npx --yes tsx scripts/check-product-facts.ts",
    "check:goal-numbers": "npx --yes tsx scripts/check-goal-numbers.ts",
    "check:baseline": "npx --yes tsx scripts/check-baseline.ts",
    "check:daily-numbers": "npx --yes tsx scripts/check-daily-numbers.ts",
    "check:brief": "npx --yes tsx scripts/check-brief.ts",
    "check:ee": "npx --yes tsx ee/check.ts",
