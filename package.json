{
  "name": "one-two-agents",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "schemas": "bash scripts/fetch-schemas.sh",
    "validate:graphql": "node scripts/validate-graphql.mjs",
    "check:policy": "npx --yes tsx scripts/check-policy.ts",
    "check:runner": "npx --yes tsx --conditions=react-server scripts/check-runner.ts",
    "check:org": "npx --yes tsx scripts/check-org.ts",
    "check:roster": "npx --yes tsx scripts/check-roster.ts",
    "check:reactions": "npx --yes tsx scripts/check-reactions.ts",
    "check:goals": "npx --yes tsx scripts/check-goals.ts",
    "check:proposals": "npx --yes tsx --conditions=react-server scripts/check-proposals.ts",
    "check:plans": "npx --yes tsx --conditions=react-server scripts/check-plans.ts",
    "check:chat": "npx --yes tsx --conditions=react-server scripts/check-chat.ts",
    "check:mcp": "npx --yes tsx scripts/check-mcp.ts",
    "check:org-switch": "npx --yes tsx scripts/check-org-switch.ts",
    "check:tenancy": "npx --yes tsx scripts/check-tenancy.ts",
    "check:roles": "npx --yes tsx scripts/check-roles.ts",
    "check:jobs": "npx --yes tsx scripts/check-jobs.ts",
    "check:packs": "npx --yes tsx scripts/check-packs.ts",
    "check:install": "npx --yes tsx --conditions=react-server scripts/check-install.ts",
    "org:new": "npx --yes tsx --conditions=react-server --env-file=.env.local scripts/new-org.ts",
    "check": "npm run typecheck && npm run lint && npm run validate:graphql"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/oidc": "4.0.3",
    "@xyflow/react": "^12.12.1",
    "lucide-react": "^0.460.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "graphql": "^17.0.2",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9"
  }
}
